---
import '../styles/global.css';
import AppInitializer from '../components/AppInitializer.jsx';
import Toast from '../components/Toast.jsx';

interface Props {
  title: string;
  hideNav?: boolean;
}

const { title, hideNav = false } = Astro.props;
const path = Astro.url.pathname;
let bgClass = 'bg-page-gym';
if (path === '/workout') bgClass = 'bg-page-weights';
else if (path === '/stats') bgClass = 'bg-page-stats';
else if (path === '/settings') bgClass = 'bg-page-settings';
else if (path === '/history') bgClass = 'bg-page-stats';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="FitPulse — Tu entrenador personal de bolsillo. Gestiona rutinas, sigue tu progreso y alcanza tus metas." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="FitPulse" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
  </head>
  <body class={`min-h-[100dvh] flex flex-col ${hideNav ? '' : 'pb-24'} ${bgClass}`}>
    <AppInitializer client:only="react" />
    <Toast client:only="react" />
    <main class={`flex-1 w-full relative overflow-x-hidden ${hideNav ? '' : 'safe-top'}`}>
      <slot />
    </main>
  </body>
</html>

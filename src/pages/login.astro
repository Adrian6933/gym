---
import MobileLayout from '../layouts/MobileLayout.astro';
import LoginButton from '../components/LoginButton.jsx';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'FitPulse',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  description:
    'FitPulse: registra tus entrenamientos, sigue tu progreso, marca récords personales y alcanza tus metas de gimnasio.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<MobileLayout
  title="FitPulse — Tu entrenador personal de bolsillo"
  description="FitPulse: registra tus entrenamientos, sigue tu progreso, marca récords personales y alcanza tus metas de gimnasio. Gratis, rápido e instalable."
  hideNav={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="min-h-[100dvh] flex flex-col items-center justify-between px-6 py-12 overflow-hidden relative bg-gym-grid bg-hero-gym">
    <div class="absolute top-[-20%] left-[-20%] w-[60vw] h-[60vw] bg-lime-500/5 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] right-[-20%] w-[50vw] h-[50vw] bg-lime-500/3 rounded-full blur-[80px] pointer-events-none"></div>

    <svg class="absolute top-[15%] right-[8%] w-16 h-16 text-lime-500/10 animate-float pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6.5 6.5 17.5 17.5" />
      <rect x="2" y="10" width="3" height="4" rx="1" />
      <rect x="19" y="10" width="3" height="4" rx="1" />
      <rect x="4" y="8" width="16" height="8" rx="1.5" />
      <rect x="6" y="9" width="12" height="6" rx="1" />
      <rect x="3" y="11" width="2" height="2" rx="0.5" />
      <rect x="19" y="11" width="2" height="2" rx="0.5" />
    </svg>

    <svg class="absolute bottom-[25%] left-[5%] w-14 h-14 text-lime-500/8 animate-float-delayed pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6.5 6.5 17.5 17.5" />
      <rect x="2" y="10" width="3" height="4" rx="1" />
      <rect x="19" y="10" width="3" height="4" rx="1" />
      <rect x="4" y="8" width="16" height="8" rx="1.5" />
      <rect x="6" y="9" width="12" height="6" rx="1" />
    </svg>

    <svg class="absolute top-[30%] left-[2%] w-12 h-24 text-lime-500/6 animate-float-slow pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
      <path d="M4 4 C 8 20, 16 20, 20 4" />
      <circle cx="4" cy="4" r="2" />
      <circle cx="20" cy="4" r="2" />
      <path d="M4 4 C 6 8, 10 10, 12 10" opacity="0.4" />
    </svg>

    <div></div>

    <div class="flex flex-col items-center text-center animate-slide-up z-10 w-full max-w-xs">
      <div class="relative mb-8">
        <div class="w-28 h-28 rounded-[2rem] gradient-lime-btn flex items-center justify-center shadow-2xl shadow-lime-500/30 animate-breathe">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#0a0a0f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.4 14.4 9.6 9.6" />
            <path d="M18.657 21.485a2 2 0 0 1-2.829 0l-1.414-1.414a2 2 0 0 1 0-2.828l.707-.707 4.243 4.243-.707.707Z" />
            <path d="m21.485 18.657-1.414-1.414" />
            <path d="M5.343 2.515a2 2 0 0 0-2.829 0L1.1 3.929a2 2 0 0 0 0 2.829l.707.707L6.05 3.222l-.707-.707Z" />
            <path d="m2.515 5.343 1.414 1.414" />
            <path d="m16.97 7.03-2.122-2.122a2 2 0 0 0-2.828 0L9.879 7.05l7.07 7.071 2.122-2.121a2 2 0 0 0 0-2.829l-2.12-2.12Z" />
            <path d="m7.05 9.879-2.12 2.122a2 2 0 0 0 0 2.828l2.12 2.121a2 2 0 0 0 2.829 0l2.121-2.121-4.95-4.95Z" />
          </svg>
        </div>
      </div>

      <h1 class="text-4xl font-black tracking-tight text-slate-100 mb-2">
        Fit<span class="text-lime-500">Pulse</span>
      </h1>
      <p class="text-slate-400 text-base leading-relaxed max-w-[280px] mb-4">
        Tu entrenador personal de bolsillo. Registra, analiza y supera tus
        marcas.
      </p>
      <ul class="text-slate-500 text-xs leading-relaxed max-w-[280px] mb-8 text-left list-disc list-inside space-y-1">
        <li>Rutinas y entrenamiento guiado con timer</li>
        <li>Récords personales y estadísticas de progreso</li>
        <li>Historial completo de tus entrenamientos</li>
      </ul>

      <LoginButton client:only="react" />
    </div>

    <p class="text-[11px] text-slate-700 text-center z-10 animate-fade-in delay-3">
      Para usar FitPulse es necesario iniciar sesión de forma segura.
    </p>
  </div>
</MobileLayout>
